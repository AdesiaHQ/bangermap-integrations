{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "nodes/**/*.ts",
    "credentials/**/*.ts",
    "../src/lib/youtube/**/*.ts",
    "../src/lib/outliers/**/*.ts"
  ],
  "exclude": ["../src/lib/**/*.test.ts"]
}
